<!DOCTYPE html>
<html>

<head>
  <% include ./_layouts/head %>
    <link href="/css/plugins/datatables/datatables.min.css" rel="stylesheet" />
    <style>
      .alignstatus {
        align-self: center;
      }
    </style>
</head>

<body class="md-skin">
  <% include ./_layouts/header %>
    <div id="wrapper">
      <% include ./_layouts/sidebar %>
        <div id="page-wrapper" class="gray-bg">
          <% include ./_layouts/search %>

            <div class="row">
              <div class="col-sm-12">
                <div class="title-action">
                  <a href="/organizations" class="btn btn-primary">Add Organization</a>
                  <a href="/requests/report" class="btn btn-secondary">Download Request Report</a>
                  <a href="/requests/full-report" class="btn btn-secondary">Download Full Request Report</a>
                </div>
              </div>
            </div>
            <div class="row" style="margin-top: 1%;">
              <div class="col-md-6">
                <div class="ibox-content">
                  <h3>Hospitals list</h3>
                  <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover" id="tblhospital">
                      <thead>
                        <tr>
                          <th>Name</th>
                          <th>Phone</th>
                          <th>Address</th>
                          <th>Action</th>
                        </tr>
                      </thead>
                    </table>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="ibox-content">
                  <h3>BloodBanks list</h3>
                  <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover" id="tblbloodbank">
                      <thead>
                        <tr>
                          <th>Name</th>
                          <th>Phone</th>
                          <th>Address</th>
                          <th>Action</th>
                        </tr>
                      </thead>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <% include ./_layouts/footer %>
        </div>
    </div>
    <% include ./_layouts/foot %>
      <script src="/js/plugins/datatables/datatables.min.js"></script>
      <script src="/js/app/organization.list.js"></script>
</body>

</html>