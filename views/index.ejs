<!DOCTYPE html>
<html>
  <head>
    <% include ./_layouts/head %>
    <link href="/css/plugins/dataTables/datatables.min.css" rel="stylesheet" />
    <style>
      .alignstatus {
        align-self: center;
      }
    </style>
  </head>

  <body class="md-skin">
    <% include ./_layouts/header %>
    <div id="wrapper">
      <% include ./_layouts/sidebar %>
      <div id="page-wrapper" class="gray-bg">
        <% include ./_layouts/search %>

        <div class="row wrapper border-bottom white-bg page-heading">
          <div class="col-sm-4"><h2>This is main title</h2></div>
          <div class="col-sm-8">
            <div class="title-action">
              <a href="" class="btn btn-primary">This is action area</a>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-md-6">
            <label>Hospitals list</label>
            <div class="ibox-content">
              <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover" id="tblHospital">
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>Phone</th>
                      <th>Address</th>
                    </tr>
                  </thead>
                </table>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <label>BloodBanks list</label>
            <div class="ibox-content">
              <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover" id="tblBloodBank">
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>Phone</th>
                      <th>Address</th>
                    </tr>
                  </thead>
                </table>
              </div>
            </div>
          </div>
        </div>

        <% include ./_layouts/footer %>
      </div>
    </div>
    <% include ./_layouts/foot %>
    <script src="/js/plugins/datatables/datatables.min.js"></script>
    <script src="/js/app/organization.list.js"></script>
  </body>
</html>
