<!DOCTYPE html>
<html>
  <head>
    <% include ../_layouts/head %>
    <link href="../css/plugins/datatables/datatables.min.css" rel="stylesheet" />
    <style>
      .alignstatus {
        align-self: center;
      }
    </style>
  </head>

  <body class="md-skin">
    <% include ../_layouts/header %>
    <div id="wrapper">
      <% include ../_layouts/sidebar %>
      <div id="page-wrapper" class="gray-bg">
        <% include ../_layouts/search %>
        <div class="wrapper wrapper-content amimated fadeInRight">
          <div class="row">
            <div class="col-lg-12">
              <div class="ibox ">
                <div class="ibox-content">
                  <div class="row" style="padding:5px 24px 5px 20px;">
                    <div class="col-sm-7">
                      <h3>
                        <i class="fa fa-user"></i>&nbsp; Hospitals List
                        <small class="badge badge-warning" style="font-weight: normal"></small>
                      </h3>
                    </div>
                    <div class="col-sm-5">
                      <div class="input-group">
                        <input
                          type="text"
                          class="search form-control"
                          placeholder="Search by Hospitals name ..."
                        />
                        <span class="input-group-append">
                          <a type="button" class="btn btn-primary" href="/hospitals/add">
                            <i class="fa fa-plus"></i>&nbsp;Add
                          </a>
                        </span>
                      </div>
                    </div>
                  </div>
                  <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover groupsTable">
                      <thead>
                        <tr>
                          <th width="250">Name</th>
                          <th width="250">Phone</th>
                          <th width="120">Address</th>
                          <th width="50" style="text-align:center">Action</th>
                        </tr>
                      </thead>
                      <tbody></tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% include ../_layouts/foot %>
    <script
      type="text/javascript"
      language="javascript"
      src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"
    ></script>
    <script src="/js/plugins/datatables/datatables.bootstrap4.min.js"></script>
  </body>
</html>
