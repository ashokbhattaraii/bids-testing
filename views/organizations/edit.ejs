<!DOCTYPE html>
<html>
  <head>
    <% include ../_layouts/head %>
    <link href="/css/plugins/datatables/datatables.min.css" rel="stylesheet" />
    <style>
      .alignstatus {
        align-self: center;
      }
      .dataTables_wrapper {
        padding-bottom: 0px;
      }
      .ibox-title {
        padding: 15px 40px 5px 40px;
      }

      @media screen and (max-width: 480px) {
        .hide {
          display: none;
        }
      }
    </style>
    <script>
      const organizationId = "<%= organization.id %>";
    </script>
  </head>

  <body class="md-skin">
    <% include ../_layouts/header %>
    <div id="wrapper">
      <% include ../_layouts/sidebar %>
      <div id="page-wrapper" class="gray-bg">
        <% include ../_layouts/search %>

        <div class="wrapper wrapper-content">
          <div class="ibox-content">
            <form action="" method="post" id="frmorgEdit">
              <div class="row">
                <div class="col-sm-6">
                  <div class="col-md-12">
                    <div class="form-group form-group--float">
                      <label><b>Name</b></label>
                      <input
                        type="text"
                        id="name"
                        name="name"
                        value=""
                        class="form-control"
                        data-validation="required"
                      />
                    </div>
                  </div>

                  <div class="col-md-12">
                    <div class="form-group">
                      <label><b>Phone (Primary Contact)</b></label>
                      <input
                        type="number"
                        id="phone"
                        name="phone"
                        value=""
                        class="form-control"
                        data-validation="length alphanumeric required"
                        data-validation-length="7-15"
                      />
                    </div>
                  </div>

                  <div class="col-md-12">
                    <div class="form-group" id="contact_fields_edit">
                      <label><b>Secondary Contact</b></label>
                      <a
                        onclick="$('#frmorgEdit').trigger('secondary-contact')"
                        class="btn btn-dark btn-xs fa fa-plus text-white"
                        >&nbsp;Add</a
                      >
                    </div>
                  </div>

                  <div class="col-md-12">
                    <div class="form-group">
                      <label><b>Address</b></label>
                      <input
                        type="text"
                        id="address"
                        name="address"
                        value=""
                        class="form-control"
                        data-validation="required"
                      />
                    </div>
                  </div>

                  <div class="col-md-12">
                    <div class="form-group">
                      <label><b>Organization Type</b></label>
                      <select class="form-control m-b" name="type">
                        <option value="">Select Option</option>
                        <option value="rumsan">Rumsan</option>
                        <option value="nphl">nphl</option>
                        <option value="bloodbank">Bloodbank</option>
                        <option selected value="hospital">Hospital</option>
                      </select>
                    </div>
                  </div>

                  <div class="hr-line-dashed"></div>
                  <div class="form-group row">
                    <div class="col-sm-4 col-sm-offset-2">
                      <a href="/organizations" class="btn btn-white btn-sm" type="cancel">Cancel</a>
                      <button class="btn btn-primary btn-sm" type="submit">Submit</button>
                    </div>
                  </div>
                </div>
                <div class="col-sm-6">
                  <input
                    class="form-control"
                    type="text"
                    placeholder="Type your location here..."
                    id="searchLocation"
                  />
                  <div id="googleMap" style="width: 100%; height: 200px;"></div>
                  <div class="row">
                    <div class="col-sm-6">
                      <div class="form-group">
                        <label for="longitude"><b>Latitude:</b></label>
                        <input class="form-control" name="longitude" id="longitude" />
                      </div>
                    </div>
                    <div class="col-sm-6">
                      <div class="form-group">
                        <label for="latitude"><b>longitude:</b></label>
                        <input class="form-control" name="latitude" id="latitude" />
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </form>
          </div>
          <div class="ibox">
            <div class="ibox-content">
              <div class="row">
                <div class="col-md-7">
                  <h3>Employee List</h3>
                </div>
                <div class="col-sm-5">
                  <button
                    type="button"
                    id="btnAddEmployee"
                    data-toggle="modal"
                    data-target="#mdlAddEmployee"
                    class="btn btn-sm btn-primary pull-right"
                  >
                    <i class="fa fa-plus"></i>&nbsp;Add Employee
                  </button>
                </div>
                <div class="table-responsive">
                  <table
                    class="table table-striped table-bordered table-hover"
                    id="employeeList"
                    style="width: 100%;"
                  >
                    <thead>
                      <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Gender</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
        <% include ../misc/snackbar %> <% include ../_layouts/footer %>
      </div>
    </div>

    <% include ../_layouts/foot %>
    <script
      type="text/javascript"
      language="javascript"
      src="https://cdnjs.cloudflare.com/ajax/libs/jquery-form-validator/2.3.26/jquery.form-validator.min.js"
    ></script>
    <script
      type="text/javascript"
      src="https://maps.google.com/maps/api/js?v=3&key=AIzaSyBvExzwwXB7vhWchWY57j91js1EqU7Mssc&libraries=places&callback=myMap"
      async
      defer
    ></script>
    <script
      type="text/javascript"
      language="javascript"
      src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"
    ></script>
    <script src="../js/plugins/datatables/datatables.bootstrap4.min.js"></script>
    <script src="/js/gmap.js"></script>
    <script src="/js/app/organization.edit.js"></script>
    <script src="/js/app/employee.list.js"></script>
  </body>
</html>

<div id="mdlAddEmployee" class="modal fade" role="dialog">
  <div class="modal-dialog">
    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title">Add Employee</h4>
      </div>
      <div class="modal-body">
        <form action="" method="post" id="frmAddEmployee">
          <div class="form-group" id="organization_list" style="display: none;">
            <label for="organization">Organization:</label>
            <select
              class="form-control"
              name="organization"
              id="organziation"
              data-validation="required"
            >
              <option value="">Select Option</option>
            </select>
          </div>
          <input type="hidden" name="id" id="id" />
          <input type="hidden" name="org_id" id="org_id" />
          <div class="form-group">
            <label for="role">Role:</label>
            <select class="form-control" name="role" id="role" data-validation="required">
              <option value="">Select Option</option>
              <option value="Investigator">Investigator</option>
              <option value="Nurse">Nurse</option>
              <option value="Organization Admin">Org Admin</option>
              <option value="Receptionist">Receptionist</option>
            </select>
          </div>
          <div class="form-group">
            <label for="name">Name:</label>
            <input
              type="text"
              class="form-control"
              id="name"
              name="name"
              data-validation="required"
            />
          </div>
          <div class="form-group">
            <label for="password">Password</label>
            <div class="input-group">
              <input type="text" name="password" class="form-control" />
              <span class="input-group-append">
                <button
                  type="button"
                  class="btn btn-primary"
                  onclick="generatepassword()"
                  title="Create random password"
                >
                  <i class="fa fa-random"></i>
                </button>
              </span>
            </div>
          </div>
          <div class="form-group">
            <label for="phone">Phone:</label>
            <input
              type="number"
              class="form-control"
              id="phone"
              name="phone"
              data-validation="length alphanumeric required"
              data-validation-length="7-15"
            />
          </div>
          <div class="form-group">
            <label for="email">Email:</label>
            <input
              type="email"
              class="form-control"
              id="email"
              name="email"
              data-validation="required email"
            />
          </div>
          <div class="form-group">
            <label for="gender">Gender:</label>
            <select class="form-control" name="gender" id="gender">
              <option value="">Select Option</option>
              <option value="M">Male</option>
              <option value="F">Female</option>
              <option value="O">Other</option>
            </select>
          </div>

          <div class="hr-line-dashed"></div>
          <div class="form-group row">
            <div class="col-sm-4 col-sm-offset-2">
              <button type="button" class="btn btn-sm btn-default" name="btnCancel">
                Close
              </button>
              <button class="btn btn-primary btn-sm" type="submit" name="btnSave">Submit</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
