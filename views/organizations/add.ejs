<!DOCTYPE html>
<html>
  <head>
    <% include ../_layouts/head %>
    <style>
      .alignstatus {
        align-self: center;
      }
      .dataTables_wrapper {
        padding-bottom: 0px;
      }
      .ibox-title {
        padding: 15px 40px 5px 40px;
      }

      @media screen and (max-width: 480px) {
        .hide {
          display: none;
        }
      }
    </style>
  </head>

  <body class="md-skin">
    <% include ../_layouts/header %>
    <div id="wrapper">
      <% include ../_layouts/sidebar %>
      <div id="page-wrapper" class="gray-bg">
        <% include ../_layouts/search %>

        <div class="wrapper wrapper-content">
          <div class="ibox-content">
            <form action="" method="post" id="frmorgAdd">
              <div class="row">
                <div class="col-sm-6">
                  <div class="col-md-12">
                    <div class="form-group form-group--float">
                      <label><b>Name</b></label>
                      <input
                        type="text"
                        id="name"
                        name="name"
                        value=""
                        class="form-control"
                        data-validation="required"
                      />
                    </div>
                  </div>

                  <div class="col-md-12">
                    <div class="form-group">
                      <label><b>Phone</b></label>
                      <input
                        type="number"
                        id="phone"
                        name="phone"
                        value=""
                        class="form-control"
                        data-validation="length alphanumeric required"
                        data-validation-length="7-15"
                      />
                    </div>
                  </div>

                  <div class="col-md-12">
                    <div class="form-group">
                      <label><b>Address</b></label>
                      <input
                        type="text"
                        id="address"
                        name="address"
                        value=""
                        class="form-control"
                        data-validation="required"
                      />
                    </div>
                  </div>

                  <div class="col-md-12">
                    <div class="form-group">
                      <label><b>Organization Type</b></label>
                      <select class="form-control m-b" name="type">
                        <option value="">Select Option</option>
                        <option value="rumsan">Rumsan</option>
                        <option value="nphl">nphl</option>
                        <option value="bloodbank">Bloodbank</option>
                        <option selected value="hospital">Hospital</option>
                      </select>
                    </div>
                  </div>

                  <div class="hr-line-dashed"></div>
                  <div class="form-group row">
                    <div class="col-sm-4 col-sm-offset-2">
                      <a href="/organizations" class="btn btn-white btn-sm" type="cancel">Cancel</a>
                      <button class="btn btn-primary btn-sm" type="submit">Submit</button>
                    </div>
                  </div>
                </div>
                <div class="col-sm-6">
                  <input
                    class="form-control"
                    type="text"
                    placeholder="Type your location here..."
                    id="searchLocation"
                  />
                  <div id="googleMap" style="width: 100%; height: 200px;"></div>
                  <div class="row">
                    <div class="col-sm-6">
                      <div class="form-group">
                        <label for="longitude"><b>Latitude:</b></label>
                        <input class="form-control" name="longitude" id="longitude" />
                      </div>
                    </div>
                    <div class="col-sm-6">
                      <div class="form-group">
                        <label for="latitude"><b>longitude:</b></label>
                        <input class="form-control" name="latitude" id="latitude" />
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </form>
          </div>
        </div>
        <% include ../misc/snackbar %> <% include ../_layouts/footer %>
      </div>
    </div>

    <% include ../_layouts/foot %>
    <script
      type="text/javascript"
      language="javascript"
      src="https://cdnjs.cloudflare.com/ajax/libs/jquery-form-validator/2.3.26/jquery.form-validator.min.js"
    ></script>
    <script
      type="text/javascript"
      src="https://maps.google.com/maps/api/js?v=3&key=AIzaSyBvExzwwXB7vhWchWY57j91js1EqU7Mssc&libraries=places&callback=myMap"
      async
      defer
    ></script>
    <script src="/js/gmap.js"></script>
    <script src="/js/app/organization.add.js"></script>
  </body>
</html>
