<!DOCTYPE html>
<html>
  <head>
    <% include ../_layouts/head %>
    <link href="/css/plugins/datatables/datatables.min.css" rel="stylesheet" />
    <style>
      .alignstatus {
        align-self: center;
      }
      .dataTables_wrapper {
        padding-bottom: 0px;
      }
      .ibox-title {
        padding: 15px 40px 5px 40px;
      }

      @media screen and (max-width: 480px) {
        .hide {
          display: none;
        }
      }
    </style>
  </head>

  <body class="md-skin">
    <% include ../_layouts/header %>
    <div id="wrapper">
      <% include ../_layouts/sidebar %>
      <div id="page-wrapper" class="gray-bg">
        <% include ../_layouts/search %>

        <div class="wrapper wrapper-content animated fadeInRight">
          <div class="row">
            <div class="col-lg-12">
              <div class="ibox">
                <div class="ibox-title">
                  <div class="row">
                    <div class="col-md-3">
                      <h2>
                        Organizations Dispatch
                        <small
                          class="badge badge-warning"
                          style="font-weight: normal;"
                          id="txtFilter"
                        ></small>
                      </h2>
                    </div>
                    <div class="col-md-3">
                      <input
                        class="form-control"
                        type="text"
                        id="filterOrgByAddress"
                        placeholder="Search by Address"
                      />
                    </div>
                    <div class="col-md-3">
                      <input
                        class="form-control"
                        type="text"
                        id="filterOrgByName"
                        placeholder="Search by Name"
                      />
                    </div>
                    <div class="col-md-3">
                      <button
                        type="button"
                        onclick="$('.oTable').trigger('add-donor')"
                        class="btn btn-sm btn-primary"
                        style="float: right;"
                      >
                        Add donors
                      </button>
                    </div>
                  </div>
                </div>
                <div class="ibox-content">
                  <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover oTable">
                      <thead>
                        <tr>
                          <th></th>
                          <th>Name</th>
                          <th>Phone</th>
                          <th>Address</th>
                        </tr>
                      </thead>
                    </table>
                  </div>
                  <div class="form-group row">
                    <div class="col-sm-4 col-sm-offset-2">
                      <button
                        type="button"
                        class="btn btn-sm btn-default"
                        id="resetOrg"
                        data-dismiss="modal"
                      >
                        Reset
                      </button>
                      <button
                        class="btn btn-primary btn-sm"
                        id="save_organizations"
                        data-toggle="modal"
                        data-target="#mdlOrganizationView"
                        data
                        onclick="$('.oTable').trigger('show-local-org')"
                        type="submit"
                      >
                        Save
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div id="mdlOrganizationView" class="modal fade" role="dialog">
          <div class="modal-dialog modal-lg">
            <!-- Modal content-->
            <div class="modal-content">
              <div class="modal-header">
                <h4 class="modal-title">Organizations</h4>
                <input type="text" style="opacity: 0;" value="" id="orgViewText" />

                <button
                  type="button"
                  class="btn btn-sm btn-primary"
                  onclick="$('.oTable').trigger('copy-text',$(this).prev().attr('id'))"
                >
                  Copy
                </button>
              </div>
              <div class="modal-body">
                <div class="row">
                  <div class="col-lg-12">
                    <table class="table table-striped copy">
                      <thead>
                        <tr>
                          <th>#</th>
                          <th>Name</th>
                          <th>Phone</th>
                          <th>Address</th>
                          <th>Action</th>
                        </tr>
                      </thead>
                      <tbody id="orgView"></tbody>
                    </table>
                  </div>
                </div>
                <div class="hr-line-dashed"></div>
                <div class="form-group row">
                  <div class="col-sm-4 col-sm-offset-2">
                    <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">
                      Close
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <% include ../misc/snackbar %> <% include ../_layouts/footer %>
      </div>
    </div>

    <% include ../_layouts/foot %>
    <script
      type="text/javascript"
      language="javascript"
      src="https://cdnjs.cloudflare.com/ajax/libs/jquery-form-validator/2.3.26/jquery.form-validator.min.js"
    ></script>
    <!--Data Tables -->
    <script
      type="text/javascript"
      language="javascript"
      src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"
    ></script>
    <script src="/js/plugins/datatables/datatables.bootstrap4.min.js"></script>
    <script src="/js/app/request.dispatch.js"></script>

    <script>
      var rTable;

      let id = "<%= request._id %>";
      let group = "<%= request.blood_group %><%= request.rh_factor %>";
    </script>
  </body>
</html>
