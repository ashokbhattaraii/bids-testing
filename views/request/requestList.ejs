<!DOCTYPE html>
<html>
  <head>
    <% include ../_layouts/head %>
    <link href="/css/plugins/dataTables/datatables.min.css" rel="stylesheet" />
    <style>
      .alignstatus {
        align-self: center;
      }
    </style>
    <script>
      const reqId = "<%= requestId %>";
    </script>
  </head>

  <body class="md-skin">
    <% include ../_layouts/header %>
    <div id="wrapper">
      <% include ../_layouts/sidebar %>
      <div id="page-wrapper" class="gray-bg">
        <% include ../_layouts/search %>
        <div class="wrapper wrapper-content amimated fadeInRight">
          <div class="row">
            <div class="col-lg-12">
              <div class="ibox">
                <div class="ibox-content">
                  <div class="row" style="padding: 5px 24px 5px 20px;">
                    <div class="col-sm-7">
                      <h3>
                        <i class="fa fa-user"></i>&nbsp; Request Expiry URL List
                        <small class="badge badge-warning" style="font-weight: normal;"></small>
                      </h3>
                    </div>
                    <div class="col-sm-5">
                      <button
                        class="btn btn-primary"
                        onclick="$('#linksTable').trigger('open-link-modal')"
                        style="float: right;"
                      >
                        <i class="fa fa-plus"></i>&nbsp;Add
                      </button>
                    </div>
                  </div>
                  <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover" id="linksTable">
                      <thead>
                        <tr>
                          <th width="200">For</th>
                          <th>URL</th>
                          <th>Duration(hr)</th>
                          <th width="100" style="text-align: center;">Action</th>
                        </tr>
                      </thead>
                      <tbody></tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% include ../_layouts/foot %>
    <script
      type="text/javascript"
      language="javascript"
      src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"
    ></script>
    <script src="/js/plugins/dataTables/dataTables.bootstrap4.min.js"></script>
    <script src="/js/app/request.url.js"></script>
  </body>
</html>

<div id="mdlRequestLink" class="modal fade" role="dialog">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title">Create Link</h4>
      </div>
      <div class="modal-body">
        <div class="row">
          <div class="col-lg-12" style="float: inherit;">
            <form action="#" class="form-group" id="frmRequestLink">
              <div class="row">
                <input type="hidden" name="_id" id="reqId" />
                <div class="col-md-12 form-group">
                  <label for="requestor">URL:</label>
                  <input
                    type="text"
                    class="form-control"
                    name="url"
                    placeholder="The link will be automatically generated."
                    disabled
                  />
                </div>
                <div class="col-md-12 form-group">
                  <label for="requestor"
                    >Expiry Duration:
                    <span
                      data-toggle="tooltip"
                      data-placement="top"
                      title="By default, if left empty, the expiry link is set to expire at 24 hours"
                    >
                      <i class="fa fa-info-circle fa-lg" style="color: black;"></i></span
                  ></label>
                  <input type="number" class="form-control" name="duration" />
                </div>
                <div class="col-md-12 form-group">
                  <label for="requestor">Created For:</label>
                  <input type="text" class="form-control" name="created_for" />
                </div>
              </div>
              <div class="hr-line-dashed"></div>
              <div class="form-group row">
                <div class="col-sm-4 col-sm-offset-2">
                  <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">
                    Close
                  </button>
                  <button class="btn btn-primary btn-sm" type="submit">
                    Submit
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
