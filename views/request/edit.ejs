<!DOCTYPE html>
<html>
  <head>
    <% include ../_layouts/head %>
    <link href="/css/plugins/dataTables/datatables.min.css" rel="stylesheet" />
    <style>
      .alignstatus {
        align-self: center;
      }
      .dataTables_wrapper {
        padding-bottom: 0px;
      }
      .ibox-title {
        padding: 15px 40px 5px 40px;
      }
    </style>
  </head>

  <body class="md-skin">
    <% include ../_layouts/header %>
    <div id="wrapper">
      <% include ../_layouts/sidebar %>
      <div id="page-wrapper" class="gray-bg">
        <% include ../_layouts/search %>

        <div class="wrapper wrapper-content animated fadeInRight">
          <div class="row">
            <div class="col-lg-12">
              <div class="ibox ">
                <div class="ibox-title">
                  <a
                    class="btn btn-primary btn-xs"
                    style="float: right"
                    href="#"
                    id="deleteRequest"
                    onclick="deleteRequest('<%= request._id %>')"
                    title="Delete Request"
                    ><i class=" fa fa-trash user-icon"></i> Delete</a
                  >
                </div>
                <div class="ibox-content">
                  <form action="" method="post" id="frmRequestEdit">
                    <div class="row">
                      <input type="hidden" value="" id="request_id" name="request_id" />
                      <div class="col-md-6 form-group">
                        <label for="password">Requester Name</label>
                        <input
                          type="text"
                          class="form-control"
                          name="requester_name"
                          data-validation="required"
                        />
                      </div>
                      <div class="col-md-6 form-group">
                        <label for="address">Address:</label>
                        <input
                          type="text"
                          class="form-control"
                          name="address"
                          data-validation="required"
                        />
                      </div>

                      <div class="col-md-6 form-group">
                        <label for="email">Patient Name</label>
                        <input
                          type="text"
                          class="form-control"
                          name="patient_name"
                          data-validation="required Patient Name"
                        />
                      </div>
                      <div class="col-md-6 form-group">
                        <label for="phone">Requester Phone:</label>
                        <input
                          type="number"
                          class="form-control"
                          name="requester_phone"
                          data-validation-length="7-15"
                        />
                      </div>
                      <div class="col-md-6 form-group">
                        <label for="gender">Blood Group:</label>
                        <select class="form-control" name="blood_group" data-validation="required">
                          <option disabled selected value="">Select Option</option>
                          <option value="A">A</option>
                          <option value="B">B</option>
                          <option value="O">O</option>
                          <option value="AB">AB</option>
                        </select>
                      </div>

                      <div class="col-md-6 form-group">
                        <label for="gender">Rh Factor:</label>
                        <select class="form-control" name="rh_factor" data-validation="required">
                          <option disabled selected value="">Select Option</option>
                          <option value="+">+</option>
                          <option value="-">-</option>
                        </select>
                      </div>

                      <div class="col-md-12 form-group">
                        <label for="email">Hospital</label>
                        <input
                          type="text"
                          class="form-control"
                          name="hospital"
                          data-validation="required Hospital Name"
                        />
                      </div>
                    </div>

                    <div class="hr-line-dashed"></div>
                    <div class="form-group row">
                      <div class="col-sm-4 col-sm-offset-2">
                        <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">
                          Close
                        </button>
                        <button class="btn btn-primary btn-sm" type="submit">Submit</button>
                      </div>
                    </div>
                  </form>
                </div>
              </div>
              <div class="ibox ">
                <div class="ibox-title">
                  <input type="text" style="display: none" value="" id="copyInput" />

                  <button type="button" class="btn btn-sm btn-primary" onclick="copyText()">
                    Copy
                  </button>
                </div>
                <div class="ibox-content">
                  <div class="row">
                    <div class="col-lg-12">
                      <table class="table table-striped copy">
                        <thead>
                          <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Gender</th>
                            <th>Blood Group</th>
                            <th>Action</th>
                          </tr>
                        </thead>
                        <tbody id="donorView"></tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <% include ../misc/snackbar %> <% include ../_layouts/footer %>
      </div>
    </div>

    <% include ../_layouts/foot %>
    <script
      type="text/javascript"
      language="javascript"
      src="https://cdnjs.cloudflare.com/ajax/libs/jquery-form-validator/2.3.26/jquery.form-validator.min.js"
    ></script>
    <!--Data Tables -->
    <script
      type="text/javascript"
      language="javascript"
      src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"
    ></script>
    <script src="/js/plugins/dataTables/dataTables.bootstrap4.min.js"></script>

    <script>
      function copyText(text) {
        var text = "";

        $(".copy tr").each(function() {
          /*     alert($(this).find('td').eq(1).text());
           */

          text += $(this)
            .find("td")
            .eq(1)
            .text();
          text +=
            " " +
            $(this)
              .find("td")
              .eq(2)
              .text() +
            ", ";
        });

        text = text.replace(/,\s*$/, "").substr(2);
        var toCopy = document.getElementById("copyInput");
        toCopy.value = text;
        toCopy.style.display = "block";
        toCopy.select();
        document.execCommand("copy");
        toCopy.style.display = "none";
        if (text.length > 40) {
          var array = text.split(" ", 10);
          $("#barText").text(array.toString() + "...   copied.");
        } else {
          $("#barText").text(text + "   copied.");
        }
        $(".notification").toggleClass("active");
      }

      let setDonorsView = id => {
        $.ajax({
          url: `/api/v1/requests/${id}`,
          headers: { access_token: $.cookie("access_toke n") },
          method: "get"
        })
          .done(d => {
            let donors = d.donors
              .map((d, i) => {
                return `<tr>
                      <td>${i + 1}</td>
                      <td>${d.name}</td>
                      <td>${d.phone}</td>
                      <td class="text-navy">${d.gender}</td>
                      <td>${d.blood_group ? `${d.blood_group}` : "N/A"}</td>
                      <td>
                        <button class="btn btn-danger" onclick="removeDonor('${id}','${d._id}')">
                          <i class="fa fa-trash"></i>
                        </button>
                      </td>
                    </tr>`;
              })
              .join(" ");

            $("#donorView").html(donors);
          })
          .fail(e => alert(e.responseJSON.message));
      };

      setDonorsView("<%= request._id %>");

      let setEditForm = id => {
        $.ajax({
          url: `/api/v1/requests/${id}`,
          headers: { access_token: $.cookie("access_toke n") },
          method: "get"
        })
          .done(d => {
            $("#request_id").val(d._id);
            rs.form.set(
              "#frmRequestEdit",
              d,
              "requester_name,requester_phone,patient_name,hospital,blood_group,rh_factor,address"
            );
          })
          .fail(e => alert(e.responseJSON.message));
      };

      let editRequest = id => {
        $.ajax({
          url: `/api/v1/requests/${id}`,
          headers: { access_token: $.cookie("access_toke n") },
          method: "patch",
          data: rs.form.get("#frmRequestEdit")
        })
          .done(d => (window.location.href = "?"))
          .fail(e => alert(e.responseJSON.message));
      };

      let removeDonor = (id, donor_id) => {
        swal(
          {
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, delete it!"
          },
          result => {
            $.ajax({
              url: `/api/v1/requests/${id}/donor`,
              headers: { access_token: $.cookie("access_toke n") },
              method: "delete",
              data: {
                donor_id
              }
            })
              .done(d => {
                $("#donorView").html("");
                setDonorsView(id);
              })
              .fail(e => alert(e.responseJSON.message));
          }
        );
      };

      $("#frmRequestEdit").submit(function(e) {
        e.preventDefault();
        editRequest("<%= request._id %>");
      });

      let deleteRequest = id => {
        swal(
          {
            title: "Are you sure?",
            text: "You won't be able to revert this!",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, delete it!"
          },
          result => {
            $.ajax({
              url: `/api/v1/requests/${id}`,
              headers: { access_token: $.cookie("access_toke n") },
              method: "delete"
            })
              .done(d => {
                window.location.href = "/requests";
              })
              .fail(e => alert(e.responseJSON.message));
          }
        );
      };

      setEditForm("<%= request._id %>");
    </script>
  </body>
</html>
