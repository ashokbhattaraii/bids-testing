<!DOCTYPE html>
<html>
  <head>
    <% include ../_layouts/head %>
    <link href="/css/plugins/dataTables/datatables.min.css" rel="stylesheet" />
    <style>
      .alignstatus {
        align-self: center;
      }
      .dataTables_wrapper {
        padding-bottom: 0px;
      }
      .ibox-title {
        padding: 15px 40px 5px 40px;
      }
    </style>
  </head>

  <body class="md-skin">
    <% include ../_layouts/header %>
    <div id="wrapper">
      <% include ../_layouts/sidebar %>
      <div id="page-wrapper" class="gray-bg">
        <% include ../_layouts/search %>

        <div class="wrapper wrapper-content animated fadeInRight">
          <div class="row">
            <div class="col-lg-12">
              <div class="ibox ">
                <div class="ibox-title">
                  <div class="row">
                    <div class="col-sm-2">
                      <h2>
                        Donors Dispatch
                        <small
                          class="badge badge-warning"
                          style="font-weight: normal"
                          id="txtFilter"
                        ></small>
                      </h2>
                    </div>
                  </div>
                </div>
                <div class="ibox-content">
                  <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover dTable">
                      <thead>
                        <tr>
                          <th></th>
                          <th>Name</th>
                          <th>Phone</th>
                          <th>Status</th>
                          <th>Gender</th>
                          <th>Blood Group</th>
                          <th>Last Donated Date</th>
                          <th>Total Donations</th>
                        </tr>
                      </thead>
                    </table>
                  </div>
                  <div class="form-group row">
                    <div class="col-sm-4 col-sm-offset-2">
                      <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">
                        Reset
                      </button>
                      <button
                        class="btn btn-primary btn-sm"
                        id="save_donors"
                        onclick="addDonors('<%= request._id %>')"
                        type="submit"
                      >
                        Save
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <% include ../_layouts/footer %>
      </div>
    </div>

    <% include ../_layouts/foot %>
    <script
      type="text/javascript"
      language="javascript"
      src="https://cdnjs.cloudflare.com/ajax/libs/jquery-form-validator/2.3.26/jquery.form-validator.min.js"
    ></script>
    <!--Data Tables -->
    <script
      type="text/javascript"
      language="javascript"
      src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"
    ></script>
    <script src="/js/plugins/dataTables/dataTables.bootstrap4.min.js"></script>

    <script>
      let host = "http://localhost:3012";
      var rTable;

      let id = "<%= request._id %>";
      let group = "<%= request.blood_group %><%= request.rh_factor %>";

      let throwDonorModal = (id, group) => {
        $(".dTable").DataTable({
          pageLength: 25,
          processing: true,
          responsive: true,
          filter: true,
          sort: false,
          serverSide: true,
          searchDelay: 500,
          dom: "<'row'<'col-sm-12'tr>>" + "<'row'<'col-sm-4'i><'col-sm-8'<'float-right p-2'p>>>",
          ajax: {
            url:
              host + "/api/v1/requests/dispatch/" + id + "?" + "group=" + encodeURIComponent(group),
            headers: { access_token: $.cookie("access_token") },
            dataFilter: data => {
              let json = JSON.parse(data);
              json.recordsTotal = json.total;
              json.recordsFiltered = json.total;
              return JSON.stringify(json); // return JSON string
            },
            data: function(d) {
              return $.extend(
                {},
                {
                  start: d.start,
                  limit: d.length,
                  search: d.search.value
                }
              );
            }
          },
          columns: [
            {
              data: null,
              render: data => {
                if (isValidDonorLocal(id, data._id)) {
                  return `<input type="checkbox" checked onchange="removeDonorLocal('${id}','${
                    data._id
                  }')">`;
                } else {
                  return `<input type="checkbox" onchange="setDonorLocal('${id}','${data._id}')">`;
                }
              }
            },
            {
              data: "name"
            },
            {
              data: "phone"
            },
            {
              data: null,
              render: data => {
                if (data.status) {
                  if (data.status === "clean") {
                    return "Clean";
                  } else {
                    return "Reactive";
                  }
                } else {
                  return "N/A";
                }
              }
            },
            {
              data: "gender"
            },
            {
              data: null,
              render: d => {
                return d.blood_group ? d.blood_group : "N/A";
              }
            },
            {
              data: null,
              render: data => {
                if (!data.last_donated_date) return "";
                else return moment(data.last_donated_date).format("YYYY-MM-DD");
              }
            },
            {
              data: null,
              render: data => {
                return data.donations_legacy ? data.donations_legacy.length : 0;
              }
            }
          ]
        });
      };

      throwDonorModal(id, group);

      let isValidDonorLocal = (request_id, donor_id) => {
        let isValid = false;

        var retrievedObject = localStorage.getItem(request_id);
        if (retrievedObject) {
          var donors = JSON.parse(retrievedObject);
          for (var d of donors) {
            if (d == donor_id) {
              isValid = true;
            }
          }
        }

        return isValid;
      };

      let getDonorLocal = request_id => {
        let donors = [];
        var retrievedObject = localStorage.getItem(request_id);
        if (retrievedObject) {
          donors = JSON.parse(retrievedObject);
        }
        return donors;
      };

      let removeDonorLocal = (request_id, donor_id) => {
        var retrievedObject = localStorage.getItem(request_id);
        if (retrievedObject) {
          var donors = JSON.parse(retrievedObject);
          for (var i = 0; i < donors.length; i++) {
            if (donors[i] == donor_id) {
              donors.splice(i, 1);
              i--;
            }
          }

          localStorage.setItem(request_id, JSON.stringify(donors));
        }
      };

      let setDonorLocal = (request_id, donor_id) => {
        let donors = [];
        var retrievedObject = localStorage.getItem(request_id);

        retrievedObject = JSON.parse(retrievedObject);
        if (retrievedObject) {
          retrievedObject.push(donor_id);
          donors = retrievedObject;
        }

        donors.push(donor_id);

        localStorage.setItem(request_id, JSON.stringify(donors));
      };

      let addDonors = request_id => {
        $.ajax({
          url: `/api/v1/requests/${request_id}/donor`,
          method: "POST",
          headers: { access_token: $.cookie("access_token") },
          data: { donors: getDonorLocal(request_id) }
        })
          .done(d => {
            swal("Successfully Added");
          })
          .fail(e => alert(e.responseJSON.message));
      };

      let getDonors = (id, group) => {
        throwDonorModal(id, group);
      };

      function copyText(text) {
        var text = "";

        $(".copy tr").each(function() {
          /*     alert($(this).find('td').eq(1).text());
           */

          text += $(this)
            .find("td")
            .eq(1)
            .text();
          text +=
            " " +
            $(this)
              .find("td")
              .eq(2)
              .text() +
            ", ";
        });

        text = text.replace(/,\s*$/, "").substr(2);
        var toCopy = document.getElementById("copyInput");
        toCopy.value = text;
        toCopy.style.display = "block";
        toCopy.select();
        document.execCommand("copy");
        toCopy.style.display = "none";

        alert("Copied " + toCopy.value);
      }

      let showLocalDonors = id => {
        $.ajax({
          url: `/api/v1/requests/${id}`,
          headers: { access_token: $.cookie("access_toke n") },
          method: "get"
        })
          .done(d => {
            let donors = d.donors
              .map((d, i) => {
                return `<tr>
                      <td>${i + 1}</td>
                      <td>${d.name}</td>
                      <td>${d.phone}</td>
                      <td class="text-navy">${d.gender}</td>
                      <td>${d.blood_group ? `${d.blood_group}` : "N/A"}</td>
                      <td>
                        <button class="btn btn-danger" onclick="removeDonor('${id}','${d._id}')">
                          <i class="fa fa-trash"></i>
                        </button>
                      </td>
                    </tr>`;
              })
              .join(" ");

            $("#donorView").html(donors);
          })
          .fail(e => alert(e.responseJSON.message));
      };
    </script>
  </body>
</html>
