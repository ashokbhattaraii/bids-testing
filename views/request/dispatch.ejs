<!DOCTYPE html>
<html>

<head>
  <% include ../_layouts/head %>
  <link href="/css/plugins/datatables/datatables.min.css" rel="stylesheet" />
  <style>
    .alignstatus {
      align-self: center;
    }

    .dataTables_wrapper {
      padding-bottom: 0px;
    }

    .ibox-title {
      padding: 15px 40px 5px 40px;
    }

    div.scroll {
      background-color: white;
      width: 700px;
      height: 500px;
      overflow-x: hidden;
      overflow-y: auto;
      text-align: center;
      padding: 20px;
    }

    .rate {
      float: left;
      height: 46px;
      padding: 0 10px;
    }

    .rate:not(:checked)>input {
      position: absolute;
      top: -9999px;
    }

    .rate:not(:checked)>label {
      float: right;
      width: 1em;
      overflow: hidden;
      white-space: nowrap;
      cursor: pointer;
      font-size: 30px;
      color: #ccc;
    }

    .rate:not(:checked)>label:before {
      content: "★ ";
    }

    .rate>input:checked~label {
      color: #ffc700;
    }

    .rate:not(:checked)>label:hover,
    .rate:not(:checked)>label:hover~label {
      color: #deb217;
    }

    .rate>input:checked+label:hover,
    .rate>input:checked+label:hover~label,
    .rate>input:checked~label:hover,
    .rate>input:checked~label:hover~label,
    .rate>label:hover~input:checked~label {
      color: #c59b08;
    }

    @media screen and (max-width: 480px) {
      .hide {
        display: none;
      }
    }
  </style>
</head>

<body class="md-skin">
  <% include ../_layouts/header %>
  <div id="wrapper">
    <% include ../_layouts/sidebar %>
    <div id="page-wrapper" class="gray-bg">
      <% include ../_layouts/search %>

      <div class="wrapper wrapper-content animated fadeInRight">
        <div class="row">
          <div class="col-lg-12">
            <div class="ibox">
              <div class="ibox-title">
                <div class="row">
                  <div class="col-md-3">
                    <h2>
                      Donors Dispatch
                      <small class="badge badge-warning" style="font-weight: normal;" id="txtFilter"></small>
                    </h2>
                  </div>
                  <div class="col-md-2">
                    <input class="form-control" type="text" id="filterByAddress" placeholder="Search by Address" />
                  </div>
                  <div class="col-md-2">
                    <input class="form-control" type="text" id="filterByName" placeholder="Search by Name" />
                  </div>
                  <div class="col-md-2">
                    <select class="form-control" name="gender" id="filterByGender" data-validation="required">
                      <option value="">Select Gender</option>
                      <option value="M">Male</option>
                      <option value="F">Female</option>
                      <option value="O">Others</option>
                    </select>
                  </div>
                  <div class="col-md-3">
                    <button type="button" onclick="$('.dTable').trigger('add-organization')"
                      class="btn btn-sm btn-primary" style="float: right;">
                      Add Organizations
                    </button>
                  </div>
                </div>
              </div>

              <div class="ibox-content">
                <div class="table-responsive">
                  <table class="table table-striped table-bordered table-hover dTable">
                    <thead>
                      <tr>
                        <th></th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th>Gender</th>
                        <th>Blood Group</th>
                        <th>Last Contacted</th>
                        <th>Last Donated</th>
                        <th>Rate Donor</th>
                      </tr>
                    </thead>
                  </table>
                </div>
                <div class="form-group row">
                  <div class="col-sm-4 col-sm-offset-2">
                    <button type="button" class="btn btn-sm btn-default" id="resetDonor" data-dismiss="modal">
                      Reset
                    </button>
                    <button class="btn btn-primary btn-sm" id="save_donors" data-toggle="modal"
                      data-target="#mdlRequestView" data onclick="$('.dTable').trigger('show-local-donor')"
                      type="submit">
                      Save
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div id="mdlRequestView" class="modal fade" role="dialog">
        <div class="modal-dialog modal-lg">
          <!-- Modal content-->
          <div class="modal-content">
            <div class="modal-header">
              <h4 class="modal-title">Donors</h4>
              <input type="text" style="opacity: 0;" value="" id="Text" />

              <button type="button" class="btn btn-sm btn-primary"
                onclick="$('.dTable').trigger('copy-text',$(this).prev().attr('id'))">
                Copy
              </button>
            </div>
            <div class="modal-body">
              <div class="row">
                <div class="col-lg-12">
                  <table class="table table-striped copy">
                    <thead>
                      <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th class="hide">Gender</th>
                        <th>Blood Group</th>
                        <th class="hide">Address</th>
                        <th>Action</th>
                      </tr>
                    </thead>
                    <tbody id="donorView"></tbody>
                  </table>
                </div>
              </div>
              <div class="hr-line-dashed"></div>
              <div class="form-group row">
                <div class="col-sm-4 col-sm-offset-2">
                  <button type="button" class="btn btn-sm btn-default" id="btnCancel">
                    Cancel
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div id="mdlDonorHistoryAdd" class="modal fade" role="dialog">
        <div class="modal-dialog modal-lg">
          <div class="modal-content">
            <div class="modal-header">
              <h4 class="modal-title">Add Donor Rating For <mark id="donorName"></mark></h4>
            </div>
            <div class="modal-body">
              <div class="row">
                <div class="col-md-6">
                  <form action="" method="post" id="frmDonorHistoryAdd">
                    <div class="row">
                      <div class="col-md-12 form-group">
                        <label for="status">Status:</label>
                        <select class="form-control" id="donor_status" name="status" data-validation="required">
                          <option disabled selected value="">Select Option</option>
                          <option value="Accepted To Donate">Accepted To Donate</option>
                          <option value="Rejected To Donate">Rejected To Donate</option>
                          <option value="Ineligible">Ineligible</option>
                          <option value="Do Not Call">Do Not Call</option>
                          <option value="Dormant">Dormant</option>
                        </select>
                      </div>
                      <input type="hidden" value="" id="donorId" name="donor_id" />
                      <div class="col-md-6 form-group" id="status_note" style="display: none;">
                        <label for="gender">Status Note:</label>
                        <input type="text" class="form-control" name="status_note" placeholder="Enter Reason" />
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-md-12 form-group">
                        <label for="requesteddate">Last Requested Date:</label>
                        <div class="input-group date">
                          <span class="input-group-addon"><i class="fa fa-calendar"></i></span><input type="date"
                            class="form-control" name="last_request_date" value="" />
                        </div>
                      </div>
                      <div class="col-md-12 form-group">
                        <label for="rate">Rating:</label>
                        <br />
                        <div class="rate">
                          <input type="radio" id="star5" name="rating" value="5" />
                          <label for="star5" title="text">5 stars</label>
                          <input type="radio" id="star4" name="rating" value="4" />
                          <label for="star4" title="text">4 stars</label>
                          <input type="radio" id="star3" name="rating" value="3" />
                          <label for="star3" title="text">3 stars</label>
                          <input type="radio" id="star2" name="rating" value="2" />
                          <label for="star2" title="text">2 stars</label>
                          <input type="radio" id="star1" name="rating" value="1" />
                          <label for="star1" title="text">1 star</label>
                        </div>
                      </div>
                      <div class="col-md-12 form-group">
                        <label for="communication_type">Communication Type:</label>
                        <select class="form-control" id="communication_type" name="comm_type"
                          data-validation="required">
                          <option disabled selected value="">Select Option</option>
                          <option value="call_received">Call Received</option>
                          <option value="call_made">Call Made</option>
                          <option value="email">Email</option>
                          <option value="sms">SMS</option>
                        </select>
                      </div>
                      <div class="col-md-12 form-group">
                        <label for="comments">Comments:</label>
                        <textarea class="form-control" id="comments" name="comments" rows="5"></textarea>
                      </div>
                    </div>
                    <div class="form-group row">
                      <div class="col-sm-6">
                        <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">
                          Close
                        </button>
                        <button class="btn btn-primary btn-sm" type="submit">
                          Submit
                        </button>
                      </div>
                    </div>
                  </form>
                </div>
                <div class="col-md-6 row">
                  <div id="donorHistory" class="scroll"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <% include ../misc/snackbar %> <% include ../_layouts/footer %>
    </div>
  </div>

  <% include ../_layouts/foot %>
  <script type="text/javascript" language="javascript"
    src="https://cdnjs.cloudflare.com/ajax/libs/jquery-form-validator/2.3.26/jquery.form-validator.min.js"></script>
  <!--Data Tables -->
  <script type="text/javascript" language="javascript"
    src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"></script>
  <script src="/js/plugins/datatables/datatables.bootstrap4.min.js"></script>
  <script src="/js/app/request.dispatch.js"></script>

  <script>
    var rTable;
    let id = "<%= request._id %>";
    let group = "<%= request.blood_group %><%= request.rh_factor %>";
  </script>
</body>

</html>