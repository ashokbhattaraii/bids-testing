<!DOCTYPE html>
<html>

<head>
  <% include ../_layouts/head %>
    <link href="/css/plugins/datatables/datatables.min.css" rel="stylesheet" />
    <style>
      .alignstatus {
        align-self: center;
      }

      .dataTables_wrapper {
        padding-bottom: 0px;
      }

      .ibox-title {
        padding: 15px 40px 5px 40px;
      }
      label{
        margin-bottom: 0.3rem !important;
      }
    </style>
</head>

<body class="md-skin">
  <% include ../_layouts/header %>
    <div id="wrapper">
      <% include ../_layouts/sidebar %>
        <div id="page-wrapper" class="gray-bg">
          <% include ../_layouts/search %>

            <div class="wrapper wrapper-content animated fadeInRight">
              <div class="row">
                <div class="col-lg-12">
                  <div class="ibox">
                    <div class="ibox-title">
                      <form action="" method="post" id="frmRequestPatientFeedBack">
                      <div class="row">
                        <div class="col-md-6">
                          <h2>
                            Patient Feedback List
                            <small class="badge badge-warning" style="font-weight: normal;" id="txtFilter"></small>
                          </h2>
                        </div>
                        <div class="col-md-6 text-right">
                          <div class="dropdown">
                            <button class="btn btn-success dropdown-toggle" type="button" id="pfeedbackDropDown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                              Reports
                            </button>
                            <div class="dropdown-menu" aria-labelledby="pfeedbackDropDown">
                              <a class="dropdown-item" href="/requests/patient-feedback/report?timeperiod=weekly">Weekly</a>
                              <a class="dropdown-item" href="/requests/patient-feedback/report?timeperiod=monthly">Monthly</a>
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="row">
                        <div class="col-md-2 form-group">
                          <label for="fromDate">From Date:</label>
                          <div class="input-group date">
                            <span class="input-group-addon"><i class="fa fa-calendar"></i></span
                            ><input type="date" class="form-control" id="from_date" value="" onchange="$('#tblPatientFeedbackRequest').trigger('table-load-by-date')"/>
                          </div>
                        </div>
                        <div class="col-md-2 form-group">
                          <label for="toDate">To Date:</label>
                          <div class="input-group date">
                            <span class="input-group-addon"><i class="fa fa-calendar"></i></span
                            ><input type="date" class="form-control" id="to_date" value="" onchange="$('#tblPatientFeedbackRequest').trigger('table-load-by-date')"/>
                          </div>
                        </div>  
                        <div class="col-md-2 mt-4">
                          <input class="form-control" type="text" id="filterByPhone" placeholder="Search by Phone" />
                        </div>
                        <div class="col-md-2 mt-4">
                          <input class="form-control" type="text" id="filterByName" placeholder="Search by Name" />
                        </div>
                        <div class="col-md-2 mt-4">
                          <select class="form-control m-b" id="filterByStatus">
                            <option value="">Filter by Status</option>
                            <option value="new">New</option>
                            <option value="in-progress">In-Progress</option>
                            <option value="completed">Completed</option>
                            <option value="cancelled">Cancelled</option>
                          </select>
                        </div>
                        <div class="col-md-2 mt-4">
                          <select class="form-control m-b" id="filterByGroup">
                            <option value="">Filter by BG</option>
                            <option value="A+">A +ve</option>
                            <option value="B+">B +ve</option>
                            <option value="AB+">AB +ve</option>
                            <option value="O+">O +ve</option>
                            <option value="A-">A -ve</option>
                            <option value="B-">B -ve</option>
                            <option value="AB-">AB -ve</option>
                            <option value="O-">O -ve</option>
                          </select>
                        </div>
                      </div>
                 
                    </form>
                    <div class="ibox-content">
                      <div class="table-responsive">
                        <table class="table table-striped table-bordered table-hover" id="tblPatientFeedbackRequest">
                          <thead>
                            <tr>
                              <th>Patient Name</th>
                              <th>Phone</th>
                              <th>Patient Email</th>
                              <th>Requestor Name</th>
                              <th>Hospital</th>
                              <th>Blood Group</th>
                              <th>Blood Required Date</th>
                              <th>Managed From</th>
                              <th>Status</th>
                              <th>Requested Date</th>
                              <th>Patient Status</th>
                              <th width="120" style="text-align: center;">
                                Is Verified?
                              </th>
                              <th>Action</th>
                            </tr>
                          </thead>
                          <tbody></tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <% include ../_layouts/footer %>
        </div>
    </div>

    <% include ../_layouts/foot %>
      <script type="text/javascript" language="javascript"
        src="https://cdnjs.cloudflare.com/ajax/libs/jquery-form-validator/2.3.26/jquery.form-validator.min.js"></script>
      <!--Data Tables -->
      <script type="text/javascript" language="javascript"
        src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"></script>
      <script src="/js/plugins/select2/select2.min.js"></script>
      <script src="/js/plugins/datatables/datatables.bootstrap4.min.js"></script>
      <script src="/js/app/request.patient_feedback.js"></script>
</body>

</html>

<div id="mdlPatientFeedbackModal" class="modal fade" role="dialog">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title">Patient Feedback</h4>
      </div>
      <div class="modal-body">
        <form action="" method="post" id="frmPatientFeedbackModal">
          <div class="row">

            <div class="col-md-12 form-group">
              <label for="status">Status:</label>
              <select class="form-control" name="status" data-validation="required" data-group="patient_feedback">
                <option selected value="received">Received</option>
                <option value="pending">Pending</option>
                <option value="!contacted">Haven't Contacted</option>
              </select>
            </div>
            <div class="col-md-12 form-group">
              <label for="remarks">Email:</label>
              <input type="email" class="form-control" name="email" id="email" data-validation="required"
                data-group="patient_feedback" />
            </div>

            <div class="col-md-12 form-group">
              <label for="remarks">Remarks:</label>
              <textarea name="remarks" class="form-control" placeholder="Enter text here..."
                data-group="patient_feedback"></textarea>
              <input type="hidden" class="form-control" name="requestId" id="requestId" data-validation="required" />
            </div>
          </div>

          <div class="form-group row">
            <div class="text-center">
              <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">
                Close
              </button>
              <button type="submit" class="btn btn-sm btn-primary">
                Submit
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>