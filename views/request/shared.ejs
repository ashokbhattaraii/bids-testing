<!DOCTYPE html>
<html>
  <head>
    <% include ../_layouts/head %>
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/plugins/datatables/datatables.min.css" rel="stylesheet" />
    <style>
      .alignstatus {
        align-self: center;
      }
      .dataTables_wrapper {
        padding-bottom: 0px;
      }
      .ibox-title {
        padding: 15px 40px 5px 40px;
      }

      .sticky {
        position: sticky;
        top: 0;
        z-index: 100;
        background: white;
        height: 85px;
      }

      .buttondiv {
        float: right;
      }
      @media screen and (max-width: 480px) {
        .hide {
          display: none;
        }
        .mobButton {
          width: 100%;
        }
        .buttondiv {
          float: none;
        }
      }
    </style>
    <script>
      const requestId = "<%= request.request%>";
      const created_for = "<%= request.created_for%>";
    </script>
  </head>

  <body style="background-color: white;">
    <div>
      <div class="wrapper wrapper-content">
        <div class="row">
          <div class="col-lg-12">
            <div class="ibox text-center">
              <div class="sticky">
                <h2>Request for Blood</h2>
                <button
                  class="btn btn-danger mobButton buttondiv"
                  style="color: white;"
                  id="btnAddDonor"
                  title="Add Donor"
                >
                  <i class="fa fa-plus user-icon"></i>&nbsp;Add Donor
                </button>
              </div>
              <div class="ibox-content">
                <h4>Added Donors Information</h4>
                <div class="table-responsive">
                  <table
                    class="table table-striped table-bordered table-hover additionalDonorTable"
                  >
                    <thead>
                      <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th width="100" style="text-align: center;">
                          Action
                        </th>
                      </tr>
                    </thead>
                    <tbody></tbody>
                  </table>
                </div>
              </div>
              <h2>Request Details</h2>

              <div class="ibox-content">
                <form id="frmSharedlink">
                  <fieldset disabled="disabled">
                    <div class="row">
                      <input type="hidden" value="" id="request_id" name="request_id" />
                      <div class="col-md-6 form-group">
                        <label for="password">Requester Name</label>
                        <input
                          type="text"
                          class="form-control"
                          name="requester_name"
                          data-validation="required"
                        />
                      </div>
                      <div class="col-md-6 form-group">
                        <label for="address">Requester Email:</label>
                        <input type="text" class="form-control" name="requester_email" />
                      </div>

                      <div class="col-md-6 form-group">
                        <label for="email">Patient Name</label>
                        <input
                          type="text"
                          class="form-control"
                          name="patient_name"
                          data-validation="required Patient Name"
                        />
                      </div>
                      <div class="col-md-6 form-group">
                        <label for="phone">Requester Phone:</label>
                        <input
                          type="number"
                          class="form-control"
                          name="requester_phone"
                          data-validation-length="7-15"
                        />
                      </div>
                      <div class="col-md-6 form-group">
                        <label for="blood">Blood Group:</label>
                        <select class="form-control" name="blood" data-validation="required">
                          <option disabled selected value="">Select Option</option>
                          <option value="A+">A+</option>
                          <option value="B+">B+</option>
                          <option value="O+">O+</option>
                          <option value="AB+">AB+</option>
                          <option value="A-">A-</option>
                          <option value="B-">B-</option>
                          <option value="O-">O-</option>
                          <option value="AB-">AB-</option>
                        </select>
                      </div>

                      <div class="col-md-6 form-group">
                        <label for="requesteddate">Requested Date of Blood:</label>
                        <div class="input-group date">
                          <span class="input-group-addon"><i class="fa fa-calendar"></i></span
                          ><input type="date" class="form-control" name="requested_date" value="" />
                        </div>
                      </div>

                      <div class="col-md-6 form-group">
                        <label for="hospital">Hospital:</label>
                        <select
                          class="form-control"
                          name="hospital"
                          data-validation="required"
                          id="hospitals_list"
                        >
                          <option disabled selected value="" value="">Select Option</option>
                        </select>
                      </div>
                      <div class="col-md-6 form-group">
                        <label for="status">Status:</label>
                        <select class="form-control" name="status" data-validation="required">
                          <option selected value="new">New</option>
                          <option value="in-progress">In-Progress</option>
                          <option value="completed">Completed</option>
                          <option value="cancelled">Cancelled</option>
                        </select>
                      </div>
                      <div class="col-sm-12 form-group">
                        <div class="form-group">
                          <label>Blood Type / Quantity:</label>

                          <div class="form-row">
                            <div class="col-md-6">
                              <input
                                type="checkbox"
                                data-type="PRBC"
                                class="req-products"
                                value="PRBC"
                              />PRBC
                            </div>
                            <div class="col-md-6">
                              <input type="number" class="form-control" id="PRBC" />
                            </div>
                          </div>

                          <div class="form-row">
                            <div class="col-md-6">
                              <input
                                type="checkbox"
                                data-type="FFP"
                                class="req-products"
                                value="FFP"
                              />
                              FFP
                            </div>
                            <div class="col-md-6">
                              <input type="number" class="form-control" id="FFP" />
                            </div>
                          </div>

                          <div class="form-row">
                            <div class="col-md-6">
                              <input
                                type="checkbox"
                                data-type="PRP"
                                class="req-products"
                                value="PRP"
                              />
                              PRP
                            </div>
                            <div class="col-md-6">
                              <input type="number" class="form-control" id="PRP" />
                            </div>
                          </div>

                          <div class="form-row">
                            <div class="col-md-6">
                              <input
                                type="checkbox"
                                data-type="WB"
                                class="req-products"
                                value="WB"
                              />
                              WB
                            </div>
                            <div class="col-md-6">
                              <input type="number" class="form-control" id="WB" />
                            </div>
                          </div>

                          <div class="form-row">
                            <div class="col-md-6">
                              <input
                                type="checkbox"
                                data-type="CRY"
                                class="req-products"
                                value="CRY"
                              />
                              CRY
                            </div>
                            <div class="col-md-6">
                              <input type="number" class="form-control" id="CRY" />
                            </div>
                          </div>

                          <div class="form-row">
                            <div class="col-md-6">
                              <input
                                type="checkbox"
                                data-type="PC"
                                class="req-products"
                                value="PC"
                              />
                              PC
                            </div>
                            <div class="col-md-6">
                              <input type="number" class="form-control" id="PC" />
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="col-md-6 form-group">
                        <label for="phone">Referred By:</label>
                        <input
                          type="text"
                          class="form-control"
                          name="referred_by"
                          data-validation-length="7-15"
                        />
                      </div>

                      <div class="col-md-6 form-group">
                        <label for="phone">Remarks:</label>
                        <input
                          type="text"
                          class="form-control"
                          name="remarks"
                          data-validation-length="7-15"
                        />
                      </div>
                    </div>

                    <div class="hr-line-dashed"></div>
                  </fieldset>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% include ../_layouts/foot %>
    <!--Data Tables -->
    <script
      type="text/javascript"
      language="javascript"
      src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"
    ></script>
    <script src="/js/plugins/datatables/datatables.bootstrap4.min.js"></script>
    <script src="/js/app/request.shared.js"></script>
  </body>
</html>

<div id="mdlAdditionalDonor" class="modal fade" role="dialog">
  <div class="modal-dialog modal-md">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title">Add Donor</h4>
      </div>
      <div class="modal-body">
        <div class="row">
          <div class="col-lg-12" style="float: inherit;">
            <form action="#" class="form-group">
              <div class="row">
                <div class="col-md-12 form-group">
                  <label for="requestor">Donor Name:</label>
                  <input type="text" class="form-control" name="name" data-validation="required" />
                </div>
                <div class="col-md-12 form-group">
                  <label for="phone">Phone:</label>
                  <input
                    type="text"
                    class="form-control"
                    name="phone"
                    data-validation-length="7-15"
                  />
                </div>
                <div class="col-md-12 form-group">
                  <label for="address">Address:</label>
                  <input
                    type="text"
                    class="form-control"
                    name="address"
                    data-validation="required Donor Address"
                  />
                </div>
              </div>
              <div class="hr-line-dashed"></div>
              <div class="form-group row">
                <div class="col-sm-4 col-sm-offset-2">
                  <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">
                    Close
                  </button>
                  <button class="btn btn-primary btn-sm" type="submit">
                    Submit
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="mdlAdditionalDonorEdit" class="modal fade" role="dialog">
  <div class="modal-dialog modal-md">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title">Edit Donor</h4>
      </div>
      <div class="modal-body">
        <div class="row">
          <div class="col-lg-12" style="float: inherit;">
            <form action="#" class="form-group">
              <div class="row">
                <input type="hidden" class="form-control" name="flag" value="1" />
                <div class="col-md-12 form-group">
                  <label for="requestor">Donor Name:</label>
                  <input type="text" class="form-control" name="name" data-validation="required" />
                </div>
                <div class="col-md-12 form-group">
                  <label for="phone">Phone:</label>
                  <input
                    type="text"
                    class="form-control"
                    name="phone"
                    data-validation-length="7-15"
                  />
                </div>
                <div class="col-md-12 form-group">
                  <label for="address">Address:</label>
                  <input
                    type="text"
                    class="form-control"
                    name="address"
                    data-validation="required Donor Address"
                  />
                </div>
              </div>
              <div class="hr-line-dashed"></div>
              <div class="form-group row">
                <div class="col-sm-4 col-sm-offset-2">
                  <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">
                    Close
                  </button>
                  <button class="btn btn-primary btn-sm" type="submit">
                    Submit
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
