<!DOCTYPE html>
<html>

<head>
  <% include ../_layouts/head %>
  <link href="/css/plugins/datatables/datatables.min.css" rel="stylesheet" />
  <link href="/css/plugins/select2/select2.min.css" rel="stylesheet" />
  <style>
    .alignstatus {
      align-self: center;
    }

    .dataTables_wrapper {
      padding-bottom: 0px;
    }

    .ibox-title {
      padding: 15px 40px 5px 40px;
    }

    * {
      margin: 0;
      padding: 0;
    }

    .rate {
      float: left;
      height: 46px;
      padding: 0 10px;
    }

    .rate:not(:checked)>input {
      position: absolute;
      top: -9999px;
    }

    .rate:not(:checked)>label {
      float: right;
      width: 1em;
      overflow: hidden;
      white-space: nowrap;
      cursor: pointer;
      font-size: 30px;
      color: #ccc;
    }

    .rate:not(:checked)>label:before {
      content: "★ ";
    }

    .rate>input:checked~label {
      color: #ffc700;
    }

    .rate:not(:checked)>label:hover,
    .rate:not(:checked)>label:hover~label {
      color: #deb217;
    }

    .rate>input:checked+label:hover,
    .rate>input:checked+label:hover~label,
    .rate>input:checked~label:hover,
    .rate>input:checked~label:hover~label,
    .rate>label:hover~input:checked~label {
      color: #c59b08;
    }

    .select2-container--default .select2-selection--single {
      border-top: 1px solid;
      border-bottom: 1px solid;
      border-left: 1px solid;
      border-right: 1px solid;
      border-radius: 1px;
    }

    .select2-container .select2-selection--single {
      height: 30px;
    }

    .verified-tick{
      color: green;
    }
  </style>
</head>
<script>
  const donorId = "<%=donor._id%>";
</script>

<body class="md-skin">
  <% include ../_layouts/header %>
  <div id="wrapper">
    <% include ../_layouts/sidebar %>
    <div id="page-wrapper" class="gray-bg">
      <% include ../_layouts/search %>

      <div class="wrapper wrapper-content animated fadeInRight">
        <div class="row">
          <div class="col-lg-12">
            <div class="ibox">
              <div class="ibox-title">
                <a class="btn btn-primary btn-xs" style="float: right;" href="#" id="deleteRequest"
                  onclick="deleteRequest('<%= donor._id %>')" title="Delete Request"><i
                    class="fa fa-trash user-icon"></i> Delete</a>
              </div>
              <div class="ibox-content">
                <form action="" method="post" id="frmDonorEdit">
                  <div class="row">
                    <!-- <input type="hidden" value="" id="donor_id" name="donor_id" /> -->
                    <div class="col-md-6 form-group">
                      <label for="donorname">Donor Name:</label>
                      <input type="text" class="form-control" name="name" data-validation="required" />
                    </div>
                    <div class="col-md-6 form-group">
                      <label for="phone">Donor Phone:</label>
                      <input type="number" class="form-control" name="phone" data-validation-length="7-15" />
                    </div>
                    <div class="col-md-6 form-group">
                      <label for="dob">Date of birth:</label>
                      <input type="date" class="form-control" name="dob"/>
                    </div>
                    <div class="col-md-6 form-group">
                      <label for="gender">Gender:</label>
                      <select class="form-control" name="gender" data-validation="required">
                        <option disabled selected value="">Select Option</option>
                        <option value="M">M</option>
                        <option value="F">F</option>
                      </select>
                    </div>
                    <div class="col-md-6 form-group">
                      <label for="email">Email:</label>
                      <input type="email" class="form-control" name="email" data-validation="required" />
                    </div>
                    <div class="col-md-6 form-group">
                      <label for="address">Address:</label>
                      <input type="text" class="form-control" name="address" data-validation="required" />
                    </div>
                    <div class="col-md-6 form-group">
                    <label for="bloodgroup">Blood Group:&nbsp;<i class="fa fa-check verified-tick" style="display: none;"></i></label>
                    <select class="form-control" name="bloodgroup" data-validation="required">
                      <option disabled selected value="">Select Option</option>
                      <option value="A">A</option>
                      <option value="B">B</option>
                      <option value="O">O</option>
                      <option value="AB">AB</option>
                    </select>
                  </div>
                    <div class="col-md-6 form-group">
                      <label for="rhfactor">Rh factor:&nbsp;<i class="fa fa-check verified-tick" style="display: none;"></i></label>
                      <select class="form-control" name="rh_factor" data-validation="required">
                        <option disabled selected value="">Select Option</option>
                        <option value="+">+</option>
                        <option value="-">-</option>
                      </select>
                    </div>

                    <div class="col-md-6 form-group">
                      <label for="donor_status">Status:</label>
                      <select class="form-control" id="donor_status" name="status" data-validation="required">
                        <option disabled selected value="">Select Option</option>
                        <option value="accepted">Accepted To Donate</option>
                        <option value="rejected">Rejected To Donate</option>
                        <option value="ineligible">Ineligible</option>
                        <option value="do_not_call">Do Not Call</option>
                        <option value="dormant">Dormant</option>
                      </select>
                      
                    </div>
                    <div class="col-md-6 form-group">
                      <label for="source">Source:</label>
                      <input type="text" class="form-control" name="source" data-validation="required" />
                    </div>
                    <div class="col-md-12 form-group">
                      <label for="comments">Remarks:</label>
                      <textarea class="form-control" id="status_note" name="status_note" rows="5"></textarea>
                    </div>
                  </div>
                  <div class="hr-line-dashed"></div>
                  <div class="form-group row">
                    <div class="col-sm-4 col-sm-offset-2">
                      <button class="btn btn-primary btn-sm" type="submit">Submit</button>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- <div class="ibox">
          <div class="ibox-content">
            <div class="row" style="padding:5px 24px 5px 20px;">
              <div class="col-sm-7">
                <h3>
                  <i class="fa fa-user"></i>&nbsp;Donor History
                  <small class="badge badge-warning" style="font-weight: normal"></small>
                </h3>
              </div>
              <div class="col-sm-5"></div>
            </div>
            <div class="table-responsive">
              <table class="table table-striped table-bordered table-hover" id="frmDonorList">
                <thead>
                  <tr>
                    <th>Rate</th>
                    <th>Comments</th>
                  </tr>
                </thead>
                <tbody></tbody>
              </table>
            </div>
          </div>
        </div> -->
      <% include ../_layouts/footer %>
    </div>
  </div>

  <% include ../_layouts/foot %>
  <!--Data Tables -->
  <script type="text/javascript" language="javascript"
    src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"></script>
  <script src="/js/plugins/datatables/datatables.bootstrap4.min.js"></script>
  <script src="/js/plugins/select2/select2.min.js"></script>
  <script src="/js/app/donor.edit.js"></script>
  <script>
    $(".js-example-tags").select2({
      tags: true
    });
  </script>
</body>

</html>