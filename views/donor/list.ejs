<!DOCTYPE html>
<html>
  <head>
    <% include ../_layouts/head %>
    <link href="/css/plugins/dataTables/datatables.min.css" rel="stylesheet" />
    <style>
      .alignstatus {
        align-self: center;
      }
      .dataTables_wrapper {
        padding-bottom: 0px;
      }
      .ibox-title {
        padding: 15px 40px 5px 40px;
      }
    </style>
  </head>

  <body class="md-skin">
    <% include ../_layouts/header %>
    <div id="wrapper">
      <% include ../_layouts/sidebar %>
      <div id="page-wrapper" class="gray-bg">
        <% include ../_layouts/search %>

        <div class="wrapper wrapper-content animated fadeInRight">
          <div class="row">
            <div class="col-lg-12">
              <div class="ibox ">
                <div class="ibox-title">
                  <div class="row">
                    <div class="col-sm-4">
                      <h2>
                        Donors List
                        <small
                          class="badge badge-warning"
                          style="font-weight: normal"
                          id="txtFilter"
                        ></small>
                      </h2>
                    </div>
                    <div class="col-sm-2">
                      <input
                        class="form-control"
                        type="text"
                        id="filterPhone"
                        placeholder="Search by Phone"
                        onkeyup="page.filterByPhone(this)"
                      />
                    </div>
                    <div class="col-sm-2">
                      <input
                        class="form-control"
                        type="text"
                        id="filterName"
                        placeholder="Search by Name"
                        onkeyup="page.filterByName(this)"
                      />
                    </div>
                    <div class="col-sm-2">
                      <select
                        class="form-control m-b"
                        id="filterGroup"
                        onchange="page.filterByGroup(this)"
                      >
                        <option value="">-- By Blood Group</option>
                        <option value="A+">A +ve</option>
                        <option value="B+">B +ve</option>
                        <option value="AB+">AB +ve</option>
                        <option value="O+">O +ve</option>
                        <option value="A-">A -ve</option>
                        <option value="B-">B -ve</option>
                        <option value="AB-">AB -ve</option>
                        <option value="O-">O -ve</option>
                      </select>
                    </div>
                    <div class="col-sm-2 text-right">
                      <button
                        class="btn"
                        id="clearFilter"
                        style="display:none"
                        title="Clear filters"
                        onclick="page.clearFilter()"
                      >
                        <i class="fa fa-times-circle"></i></button
                      >&nbsp;
                      <a href="/donors/add" class="btn btn-primary"
                        ><i class="fa fa-heartbeat"></i>&nbsp;Dispatch</a
                      >
                    </div>
                  </div>
                </div>
                <div class="ibox-content">
                  <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover pTable">
                      <thead>
                        <tr>
                          <th>Name</th>
                          <th>Phone</th>
                          <th>Status</th>
                          <th>Gender</th>
                          <th>Blood Group</th>
                          <th>Last Donated Date</th>
                          <th>Total Donations</th>
                          <th width="100" style="text-align:center">
                            Action
                          </th>
                        </tr>
                      </thead>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <% include ../_layouts/footer %>
      </div>
    </div>

    <% include ../_layouts/foot %>
    <!--Data Tables -->
    <script
      type="text/javascript"
      language="javascript"
      src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js"
    ></script>
    <script src="/js/plugins/dataTables/dataTables.bootstrap4.min.js"></script>

    <script>
      let host = "http://localhost:3011";
      let access_token = "<%= token %>";
      var dtTable;
      const page = {
        resetFilter: field => {
          $("#txtFilter").text("");
          if (field != "filterGroup") $("#filterGroup").val("");
          if (field != "filterName") $("#filterName").val("");
          if (field != "filterPhone") $("#filterPhone").val("");
        },
        clearFilter: group => {
          page.resetFilter();
          dtTable.ajax.url(`${host}/api/v1/donors`).load();
          $("#clearFilter").hide();
        },

        filterByPhone: e => {
          page.resetFilter("filterPhone");
          let phone = $(e).val();
          $("#txtFilter").text("(Fitered by phone: " + phone + ")");
          $("#clearFilter").show();
          dtTable.ajax.url(host + "/api/v1/donors?phone=" + encodeURIComponent(phone)).load();
        },

        filterByName: e => {
          page.resetFilter("filterName");
          let name = $(e).val();
          $("#txtFilter").text("(Fitered by name: " + name + ")");
          $("#clearFilter").show();
          dtTable.ajax.url(host + "/api/v1/donors?name=" + encodeURIComponent(name)).load();
        },

        filterByGroup: e => {
          page.resetFilter("filterGroup");
          let group = $(e).val();
          $("#txtFilter").text("(Fitered by group: " + group + ")");
          $("#clearFilter").show();
          dtTable.ajax.url(host + "/api/v1/donors?group=" + encodeURIComponent(group)).load();
        }
      };

      $(document).ready(function() {
        dtTable = $(".pTable").DataTable({
          pageLength: 25,
          processing: true,
          responsive: true,
          filter: true,
          sort: false,
          serverSide: true,
          searchDelay: 500,
          dom: "<'row'<'col-sm-12'tr>>" + "<'row'<'col-sm-4'i><'col-sm-8'<'float-right p-2'p>>>",
          ajax: {
            url: host + "/api/v1/donors",
            // headers: { access_token },
            dataFilter: data => {
              let json = JSON.parse(data);
              json.recordsTotal = json.total;
              json.recordsFiltered = json.total;
              return JSON.stringify(json); // return JSON string
            },
            data: function(d) {
              return $.extend(
                {},
                {
                  start: d.start,
                  limit: d.length,
                  search: d.search.value
                }
              );
            }
          },
          columns: [
            {
              data: "name"
            },
            {
              data: "phone"
            },
            {
              data: null,
              render: data => {
                if (data.status) {
                  if (data.status === "clean") {
                    return "Clean";
                  } else {
                    return "Reactive";
                  }
                } else {
                  return "N/A";
                }
              }
            },
            {
              data: "gender"
            },
            {
              data: null,
              render: d => {
                return d.blood_group ? d.blood_group : "N/A";
              }
            },
            {
              data: null,
              render: data => {
                if (!data.last_donated_date) return "";
                else return moment(data.last_donated_date).format("YYYY-MM-DD");
              }
            },
            {
              data: null,
              render: data => {
                return data.donations_legacy ? data.donations_legacy.length : 0;
              }
            },
            {
              data: null,
              class: "text-center",
              render: function(data, type, full, meta) {
                return `<a href="/donors/${
                  data._id
                }/edit" title='Edit Donor'><i class='btn btn-primary btn-xs fa fa-id-card-o user-icon'></i></a>&nbsp;&nbsp;`;
              }
            }
          ]
        });
      });
    </script>
  </body>
</html>
