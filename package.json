{
  "name": "hlb-bids",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "cross-env NODE_ENV=development nodemon ./bin/www",
    "production": "NODE_ENV=production node ./bin/www",
    "client": "cd ./client && yarn dev",
    "setup": "yarn install && cd ./client && yarn install",
    "build": "NODE_ENV=production yarn install --ignore-engines && cd ./client && yarn install && yarn run prod"
  },
  "dependencies": {
    "aws-sdk": "^2.873.0",
    "axios": "^1.3.1",
    "config": "^2.0.1",
    "convert-excel-to-json": "^1.6.1",
    "cookie-parser": "~1.4.3",
    "debug": "~2.6.9",
    "ejs": "~2.5.7",
    "express": "~4.18.2",
    "handlebars": "^4.0.12",
    "helmet": "^3.22.0",
    "json2xls": "^0.1.2",
    "moment": "^2.24.0",
    "mongoose": "^6.9.0",
    "morgan": "~1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^4.6.3",
    "passport": "^0.4.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth": "^1.0.0",
    "rs-user": "https://github.com/rumsan/user.git",
    "rumsan-core": "^1.0.1",
    "rumsan-ui": "https://github.com/santosh-rumsan/rumsan-ui.git",
    "slugify": "^1.5.0",
    "uuidv4": "^6.0.7"
