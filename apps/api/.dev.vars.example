# Local development secrets for Cloudflare Workers
# DO NOT commit this file — it is listed in .gitignore
JWT_SECRET="hamro-life-bank-local-dev-secret-change-me-in-production"

# Google OAuth — create credentials at https://console.cloud.google.com/
# Authorized redirect URI to add: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=""
